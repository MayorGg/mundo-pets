# ===== Mundo Pets — variables de entorno =====
# Copia este archivo como `.env` (desarrollo) o `.env.production` (producción)
# y rellena los valores reales. NO commitees los archivos .env / .env.*.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=mundo_pets

# --- JWT ---
# Genera un secreto fuerte con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Orígenes permitidos, separados por coma. En prod: https://tudominio.com
CORS_ORIGIN=http://localhost:5000

# --- Servidor HTTP ---
# Puerto en el que escucha Express (Nginx suele hacer proxy al 5000)
PORT=5000